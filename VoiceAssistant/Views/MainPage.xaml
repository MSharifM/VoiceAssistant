<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceAssistant.MainPage" 
             Title="دستیار صوتی"
             BackgroundColor="{DynamicResource SecondaryColor}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              RowSpacing="20"
              Padding="20">

            <!-- لوگو یا عکس میکروفون -->
            <Image Grid.Row="0"
                   Source="voice_animation.gif"
                   IsAnimationPlaying="True"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center">
                <Image.Shadow>
                    <Shadow Brush="#40000000"
                            Offset="0,5"
                            Radius="10" />
                </Image.Shadow>
            </Image>

            <Label Grid.Row="1"
                   Text="برای تست امتحان کنید"
                   FontSize="18"
                   TextColor="{DynamicResource PrimaryColor}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Grid.Row="2"
                                  HorizontalOptions="Center"
                                  Spacing="15">
                <Button Text="شروع"
                        WidthRequest="120"
                        HeightRequest="50"
                        CornerRadius="25"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold">
                    <Button.Shadow>
                        <Shadow Brush="#40000000"
                                Offset="0,2"
                                Radius="5" />
                    </Button.Shadow>
                </Button>

                <Button Text="پایان"
                        WidthRequest="120"
                        HeightRequest="50"
                        CornerRadius="25"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold">
                    <Button.Shadow>
                        <Shadow Brush="#40000000"
                                Offset="0,2"
                                Radius="5" />
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>

            <Frame Grid.Row="3"
                   CornerRadius="15"
                   Padding="15"
                   BackgroundColor="{DynamicResource TertiaryColor}"
                   BorderColor="{DynamicResource PrimaryColor}"
                   HorizontalOptions="Fill">
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="End">
                    <Image Source="is_talking.gif"
                           IsAnimationPlaying="True"
                           HeightRequest="30"
                           WidthRequest="30"
                           VerticalOptions="Center" />
                    <Label Text="لاگ فعالیت‌ها:"
                           FontSize="16"
                           TextColor="{DynamicResource PrimaryColor}"
                           VerticalOptions="Center"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Frame>

            <!-- لیست لاگ‌ها -->
            <CollectionView Grid.Row="4"
                            ItemsSource="{Binding ActivityLogs}"
                            SelectionMode="None"
                            HorizontalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10"
                               Padding="10"
                               Margin="0,0,0,10"
                               BackgroundColor="{DynamicResource SecondaryContainer}"
                               BorderColor="{DynamicResource Outline}">
                            <Label Text="{Binding .}"
                                   FontSize="14"
                                   TextColor="{DynamicResource OnSecondaryContainer}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- وضعیت فعلی -->
            <Frame Grid.Row="5"
                   CornerRadius="15"
                   Padding="15"
                   BackgroundColor="{DynamicResource PrimaryColor}"
                   HorizontalOptions="Fill"
                   VerticalOptions="End">
                <Label Text="{Binding CurrentStatus}"
                       FontSize="16"
                       TextColor="{DynamicResource OnPrimary}"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" />
            </Frame>
        </Grid>
    </ScrollView>

</ContentPage>