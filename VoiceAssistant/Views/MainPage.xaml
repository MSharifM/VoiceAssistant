<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VoiceAssistant.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="دستیار صوتی"
    BackgroundColor="{DynamicResource SecondaryColor}">

    <ScrollView>
        <Grid
            Padding="20"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="20">

            <!--  لوگو یا عکس میکروفون  -->
            <Image
                Grid.Row="0"
                HeightRequest="150"
                HorizontalOptions="Center"
                IsAnimationPlaying="True"
                Source="voice_animation.gif"
                WidthRequest="150">
                <Image.Shadow>
                    <Shadow
                        Brush="#40000000"
                        Radius="10"
                        Offset="0,5" />
                </Image.Shadow>
            </Image>

            <Label
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="Center"
                Text="برای تست امتحان کنید"
                TextColor="{DynamicResource PrimaryColor}" />

            <HorizontalStackLayout
                Grid.Row="2"
                HorizontalOptions="Center"
                Spacing="15">
                <Button
                    BackgroundColor="#4CAF50"
                    Clicked="OnClickBtnStart"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="شروع"
                    TextColor="White"
                    WidthRequest="120">

                    <Button.Shadow>
                        <Shadow
                            Brush="#40000000"
                            Radius="5"
                            Offset="0,2" />
                    </Button.Shadow>
                </Button>

                <Button
                    BackgroundColor="#F44336"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="پایان"
                    TextColor="White"
                    WidthRequest="120">
                    <Button.Shadow>
                        <Shadow
                            Brush="#40000000"
                            Radius="5"
                            Offset="0,2" />
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>

            <Frame
                Grid.Row="3"
                Padding="15"
                BackgroundColor="{DynamicResource TertiaryColor}"
                BorderColor="{DynamicResource PrimaryColor}"
                CornerRadius="15"
                HorizontalOptions="Fill">
                <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                    <Image
                        HeightRequest="30"
                        IsAnimationPlaying="True"
                        Source="is_talking.gif"
                        VerticalOptions="Center"
                        WidthRequest="30" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="لاگ فعالیت‌ها:"
                        TextColor="{DynamicResource PrimaryColor}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!--  لیست لاگ‌ها  -->
            <CollectionView
                Grid.Row="4"
                HorizontalOptions="Fill"
                ItemsSource="{Binding ActivityLogs}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0,0,0,10"
                            Padding="10"
                            BackgroundColor="{DynamicResource SecondaryContainer}"
                            BorderColor="{DynamicResource Outline}"
                            CornerRadius="10">
                            <Label
                                FontSize="14"
                                Text="{Binding .}"
                                TextColor="{DynamicResource OnSecondaryContainer}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="txtLog" Text="Empty" />
            <!--  وضعیت فعلی  -->
            <Frame
                Grid.Row="5"
                Padding="15"
                BackgroundColor="{DynamicResource PrimaryColor}"
                CornerRadius="15"
                HorizontalOptions="Fill"
                VerticalOptions="End">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="{Binding CurrentStatus}"
                    TextColor="{DynamicResource OnPrimary}" />
            </Frame>
        </Grid>
    </ScrollView>

</ContentPage>